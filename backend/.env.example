APP_NAME=Novel Reader AI Backend
APP_VERSION=0.1.0
APP_ENV=development
DATABASE_URL=sqlite:///./data/novel_reader.db
JWT_SECRET_KEY=change-me-in-local-dev
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOW_QUERY_TOKEN_AUTH=false
BCRYPT_ROUNDS=12
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
CORS_ALLOW_ORIGINS=*
PROXY_ALLOW_PRIVATE_NETWORKS=true
PROXY_TIMEOUT_SECONDS=15
PROXY_MAX_REQUEST_BYTES=1048576
PROXY_MAX_RESPONSE_BYTES=5242880
SOURCE_TIMEOUT_SECONDS=8
SOURCE_MAX_CONCURRENCY=5
SOURCE_RETRY_COUNT=1
SOURCE_REQUEST_INTERVAL_MS=500
SOURCE_CACHE_MAX_ENTRIES=1000
SESSION_ENCRYPTION_KEY=
