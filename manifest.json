{
  "name": "解码阅读",
  "appid": "__UNI__NOVELREADER",
  "description": "阅读书源解码、本地 TXT 导入与在线阅读 App",
  "versionName": "1.0.0",
  "versionCode": "10000",
  "transformPx": false,
  "app-plus": {
    "usingComponents": true,
    "nvueStyleCompiler": "uni-app",
    "compilerVersion": 3,
    "splashscreen": {
      "alwaysShowBeforeRender": false,
      "waiting": true,
      "autoclose": true,
      "delay": 0
    },
    "modules": {},
    "distribute": {
      "icons": {
        "android": {
          "hdpi": "static/branding/icon-hdpi.png",
          "xhdpi": "static/branding/icon-xhdpi.png",
          "xxhdpi": "static/branding/icon-xxhdpi.png",
          "xxxhdpi": "static/branding/icon-xxxhdpi.png"
        }
      },
      "android": {
        "permissions": [
          "android.permission.CAMERA"
        ]
      }
    }
  },
  "quickapp": {},
  "h5": {
    "devServer": {
      "proxy": {
        "/yckceo-proxy": {
          "target": "https://www.yckceo.com",
          "changeOrigin": true,
          "secure": true,
          "pathRewrite": {
            "^/yckceo-proxy": ""
          }
        },
        "/yck2026-proxy": {
          "target": "https://www.yck2026.top",
          "changeOrigin": true,
          "secure": true,
          "pathRewrite": {
            "^/yck2026-proxy": ""
          }
        }
      }
    }
  },
  "mp-weixin": {
    "appid": "",
    "setting": {
      "urlCheck": false
    },
    "usingComponents": true
  },
  "vueVersion": "2"
}
